datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())

  calendarAccounts     CalendarAccount[]
  friendshipsInitiated Friendship[]          @relation("FriendshipUserA")
  friendshipsReceived  Friendship[]          @relation("FriendshipUserB")
  ownedGroups          Group[]
  groupMemberships     GroupMembership[]
  notifications        Notification[]
  proposalsCreated     Proposal[]            @relation("ProposalsCreated")
  proposalParticipants ProposalParticipant[]

  // Set once in onboarding, correctable in Settings. Where two people's
  // preferred lengths differ the matcher takes the shorter, since that is
  // the one both are comfortable with.
  preferredHangoutMinutes Int @default(120)
  bufferMinutes           Int @default(30)

  // Which parts of the week this person actually wants to see people in —
  // appetite, not availability, which the calendar already knows. Shaped
  // { "wd-evening": "yes" | "never", ... }; absent keys mean no preference.
  hangoutTimes Json?

  // The cap on what reaches the feed in a day. More isn't better — a short
  // feed is what keeps the app something you close.
  proposalsPerDay Int @default(2)

  // Set once onboarding has been walked through, so we don't drop a
  // returning user back into it.
  onboardedAt DateTime?
}

model CalendarAccount {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  externalId String
  createdAt  DateTime @default(now())

  // Google's tokens. Stored as given, which is fine for a friends test but
  // not for real users — a refresh token is long-lived access to somebody's
  // calendar. Encrypt at rest before this leaves the allowlist.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?

  user   User            @relation(fields: [userId], references: [id])
  events CalendarEvent[]

  @@unique([userId, provider])
}

model CalendarEvent {
  id                String   @id @default(cuid())
  calendarAccountId String
  title             String
  startsAt          DateTime
  endsAt            DateTime
  rawLabel          String?
  isBusy            Boolean  @default(true)

  calendarAccount CalendarAccount @relation(fields: [calendarAccountId], references: [id])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id        String           @id @default(cuid())
  userAId   String
  userBId   String
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id])
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner     User              @relation(fields: [ownerId], references: [id])
  members   GroupMembership[]
  proposals Proposal[]
}

enum GroupMemberStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum GroupMemberRole {
  OWNER
  MEMBER
}

model GroupMembership {
  id        String            @id @default(cuid())
  groupId   String
  userId    String
  status    GroupMemberStatus @default(INVITED)
  role      GroupMemberRole   @default(MEMBER)
  createdAt DateTime          @default(now())

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ---------------------------------------------------------------------------
// Proposals — a proposed hangout, and what each person said about it.
// Every screen in the app is a view of these two tables: the feed is
// proposals you haven't answered, Upcoming is ones you accepted.
// See docs/superpowers/specs/2026-09-07-proposal-model-mvp.md
// ---------------------------------------------------------------------------

enum ProposalOrigin {
  SUGGESTED // the matcher found it
  INVITED // a person asked
}

enum ProposalStatus {
  OPEN
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum ParticipantResponse {
  PENDING
  ACCEPTED
  DECLINED
}

model Proposal {
  id          String         @id @default(cuid())
  origin      ProposalOrigin
  status      ProposalStatus @default(OPEN)
  startsAt    DateTime
  endsAt      DateTime
  // Set when the proposal belongs to a group. Its absence is what makes a
  // proposal a 1:1, which needs every participant to accept rather than two.
  groupId     String?
  createdById String?
  createdAt   DateTime       @default(now())

  group        Group?                @relation(fields: [groupId], references: [id])
  createdBy    User?                 @relation("ProposalsCreated", fields: [createdById], references: [id])
  participants ProposalParticipant[]

  @@index([startsAt])
  @@index([status])
}

model ProposalParticipant {
  id              String              @id @default(cuid())
  proposalId      String
  userId          String
  response        ParticipantResponse @default(PENDING)
  respondedAt     DateTime?
  // The event on this person's calendar, once the hangout is actually on.
  // Null until quorum, which is what stops a 1:1 accepter holding an event
  // for a hangout the other person declined.
  calendarEventId String?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([proposalId, userId])
  @@index([userId, response])
}
